# 复制为 .env 后按需修改（docker compose 会自动读取 .env）
# 说明：大模型 / 联网搜索 / 飞书 / 微信 / SMTP 的 Key 与口令不走环境变量，
#       而是在「系统管理」页面录入，并用 PH_SECRET_KEY（Fernet）加密存库。

# --- 应用 ---
PH_DATA_DIR=/data                 # 数据目录（SQLite、secret.key、导出文件）
PH_DB_PATH=                       # 可选：自定义数据库路径，默认 $PH_DATA_DIR/workbench.db
PH_SECRET_KEY=                    # 可选：Fernet 密钥，留空则首次启动自动生成 $PH_DATA_DIR/secret.key
PH_AUTH_MODE=                     # 可选：认证模式（默认即可）
PH_DISABLE_SCHEDULER=0            # 1=关闭定时任务（M1 采集、备份等）
PH_HTTP_RETRIES=3                 # 外部 HTTP 重试次数
PH_RETRY_BASE=1                   # 重试退避基数（秒）

# --- 备份 ---
PH_BACKUP_DIR=/backup             # 容器内备份目录
PH_BACKUP_HOST_DIR=./backups      # 宿主机备份目录（docker compose 挂载）

# --- 端口 / HTTPS ---
PH_HTTP_PORT=8000                 # 本地体验端口
# 启用 Caddy HTTPS（docker compose --profile https）前，请把 deploy/Caddyfile 中的 your.domain.example 改为你的域名/IP

# --- 在「系统管理」页面配置（仅作清单，不在此填写）---
# 大模型：MiniMax / DeepSeek / 其他 OpenAI 兼容服务 API Key
# 联网搜索：Tavily API Key、阿里云 IQS API Key
# 飞书机器人：App ID / App Secret / Verification Token / Encrypt Key
# 微信机器人：扫码绑定（bot_token 自动获取并加密保存）
# 邮件：SMTP 主机 / 端口 / 账号 / 密码 / 允许的收件域名
